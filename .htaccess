RewriteEngine On

# The document root now doubles as this repo's root (needed for hosts, like Hostinger's Git
# deploy, that always serve whatever folder the repo lands in and don't offer a way to point
# the docroot at a public/ subfolder instead). These directories/files are source, config and
# tooling only — never meant to be fetched directly — so block them outright before anything
# else runs.
# (Note: the Tailwind CSS source lives in tailwind-src/, deliberately not named "resources" —
# the app has a real page at the URL /resources, which a same-named directory here would
# otherwise collide with: Apache's own directory handling intercepts a bare-directory URL like
# /resources before any rewrite rule gets a chance to route it to the front controller.)
RewriteRule ^(app|config|database|routes|scripts|tailwind-src|node_modules|\.git)(/|$) - [F,L]

<FilesMatch "\.(sql|md|lock|json|ya?ml|log|env)$">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
